# Copy to .env, next to docker-compose.yml, and set at least the password. Not to be committed.

# the password of the user elastic, set when Elasticsearch first creates its data
ELASTIC_PASSWORD=choose-a-password

# memory: half the RAM meant for Elasticsearch goes to its heap, the rest to the file cache
ES_JAVA_OPTS=-Xms4g -Xmx4g
GLUTTON_JAVA_OPTS=-Xmx4g

# the port the service answers on, on this machine
GLUTTON_PORT=8080

# download and load ROR and the Crossref funder registry: now when empty, then every month
REGISTRIES_UPDATE_ENABLED=false

# versions; the published image of the service in place of one built from the checkout
#GLUTTON_IMAGE=lfoppiano/biblio-glutton-lookup:latest
#ES_VERSION=8.19.4
#GROBID_VERSION=0.9.1-crf
